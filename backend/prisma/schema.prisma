generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "mysql"
}

model Yatra {
  id               String  @id @db.VarChar(96)
  slug             String  @unique @db.VarChar(96)
  name             String  @db.VarChar(160)
  circuit          String  @db.VarChar(32)
  summary          String  @db.Text
  durationDays     Int
  startCity        String  @db.VarChar(64)
  endCity          String  @db.VarChar(64)
  difficulty       String  @db.VarChar(16)
  maxAltitudeM     Int?
  walkingKm        Int
  basePricePaise   Int
  seasonStartMonth Int     @db.TinyInt
  seasonEndMonth   Int     @db.TinyInt
  places           Json
  inclusions       Json
  exclusions       Json

  itinerary  ItineraryDay[]
  departures Departure[]

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@index([circuit])
  @@index([startCity])
}

model ItineraryDay {
  id          Int     @id @default(autoincrement())
  yatraId     String  @db.VarChar(96)
  day         Int
  title       String  @db.VarChar(160)
  description String  @db.Text
  overnight   String? @db.VarChar(64)

  yatra Yatra @relation(fields: [yatraId], references: [id], onDelete: Cascade)

  @@unique([yatraId, day])
}

model Departure {
  id          String   @id @db.VarChar(128)
  yatraId     String   @db.VarChar(96)
  startDate   DateTime @db.Date
  seatsTotal  Int
  seatsBooked Int      @default(0)
  pricePaise  Int

  yatra Yatra @relation(fields: [yatraId], references: [id], onDelete: Cascade)

  @@index([yatraId, startDate])
  @@index([startDate])
}

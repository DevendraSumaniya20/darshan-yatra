# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Browser origin allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# "prisma" uses MariaDB through DATABASE_URL.
# "memory" serves the seed catalogue from memory; data resets on restart.
DATA_SOURCE=prisma

# Required when DATA_SOURCE=prisma.
DATABASE_URL=mysql://user:password@localhost:3306/darshan_yatra
